# Postgres connection strings (Neon recommended: https://neon.tech)
# DATABASE_URL is the pooled connection (used by the app at runtime)
# DIRECT_URL is the direct connection (used by Prisma Migrate)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connect_timeout=20"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require&connect_timeout=20"

# DOTB public API token (Settings > API in your DOTB account, requires Boutique AI subscription)
DOTB_API_TOKEN="dotb_pk_..."

# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Vercel Blob store token (created automatically when you add a Blob store to your Vercel project)
BLOB_READ_WRITE_TOKEN=""

# Seed credentials for the two initial accounts (used by `npm run db:seed`)
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="change-me-admin"
EMPLOYEE_SEED_EMAIL="employee@example.com"
EMPLOYEE_SEED_PASSWORD="change-me-employee"

# How many days back to sync orders from DOTB on each sync run
SYNC_WINDOW_DAYS="45"

# Secret that authorizes calls to /api/cron/sync (Vercel sends this automatically
# for its own Cron Jobs once set as a project env var — no need to configure it
# in vercel.json). Generate one the same way as SESSION_SECRET.
CRON_SECRET=""

# Local/dev only: how often the server auto-syncs orders on its own (see
# src/instrumentation.ts). Ignored on Vercel, which uses Cron Jobs instead.
SYNC_INTERVAL_MINUTES="5"
